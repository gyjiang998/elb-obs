    "granularity": "api_semantic_family",
    "knowledge_record_snapshot": {"gpu": 18, "npu": 146, "dsp": 9, "media": 31, "total": 204},
    "contract_zh": "每条硬件 API 记录必须映射到一个语义族模板；模板可以是可执行 Harness、共享生命周期加适配器，或明确的系统集成 recipe。只有可执行 Harness 才能直接进入固定 profile 构建，recipe 不得伪称可直接下发。",
    "coverage_levels": {
      "executable_harness": "稳定脚手架可直接适配、构建并重新真机验证",
      "lifecycle_with_adapter": "共享生命周期已提供，仍需为当前算子或格式生成受审查适配器",
      "integration_recipe": "API 暴露在系统/HDI/provider 集成层，只提供实施与证据模板"
    }
  },
  "selection_policy": {
    "production_usage": "allowed_after_semantic_match",
    "evaluation_usage": "exclude_from_template_blind_holdout",
    "claim_boundary_zh": "模板是经过审查的实现先验，不是当前热点、设备能力、功能正确或性能收益证据。",
    "required_adaptation_zh": [
      "将当前热点的输入输出、数据类型、shape/format/stride 和边界条件映射到模板",
      "替换模板中的示例 kernel 或图算子，并保留 CPU/software oracle",
      "重新执行 profile 查询、构建、部署、真机比较和端到端基准",
      "报告实际读取的 template_id、版本、复用部分和修改部分"
    ]
  },
