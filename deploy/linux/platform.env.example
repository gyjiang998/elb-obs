# Reference only. `deploy/linux/heteroctl init` writes an absolute, permission-0600
# platform.env below the selected user-owned runtime root. No system path is used.
HETERO_USER_HOME="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime"
HETERO_ROOTLESS_RUNTIME_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime"
HETERO_REPO_ROOT="/home/your-user/work/heterogeneous-enable-web"
HETERO_STATE_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/state"
HETERO_RUNTIME_ASSET_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets"
HETERO_CACHE_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/cache"
HETERO_PYTHON_BIN="/home/your-user/.local/bin/python3.11"
# device (default): server build + device; worker: server build/trace only; analysis: analysis only.
HETERO_DEPLOYMENT_MODE="device"

# Prefer exporting resource variables before `heteroctl init/install/start/restart`.
# The controller validates and persists non-empty overrides here; refresh-env is
# not required. LLVM must contain executable clang, clang++ and ld.lld.
HETERO_TRACE_STREAMER="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/trace-streamer/trace_streamer_linux"
HETERO_LLVM_BIN_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/llvm/bin"
HETERO_GLSLANG_BIN="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/glslang/bin/glslang"
HETERO_OPENHARMONY_SDK_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/openharmony-sdk"
# Optional maintainer-only SDK for an explicit `heteroctl pmu` rebuild.
# Normal install/start/restart use the repository bundle without this SDK.
HETERO_OPENHARMONY_NATIVE_SDK_ROOT=""
# Destination automatically provisioned from the repository; no manual copy.
HETERO_PMU_SAMPLER_BUNDLE_ROOT="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/pmu-sampler"
# Preferred shared AArch64 OpenHarmony .so source; start/restart registers its
# content hashes without copying the libraries.
HETERO_RUNTIME_LIBRARY_ROOT="/home/your-user/work/openharmony-runtime-libraries"
# Advanced immutable-deployment compatibility path.
HETERO_BUILD_RUNTIME_LIBRARY_ROOT=""
# Only set when the phone is attached directly to Linux. Windows Device Bridge
# configures its own hdc.exe and does not use this Linux variable.
HETERO_HDC_BIN=""
HETERO_DEFAULT_SOURCE_ROOT=""
HETERO_TRACE_FIXTURE_ROOT=""
HETERO_AGENT_ENGINE="kimi_server"
HETERO_AGENT_CLI_ADAPTER="kimi"
# Optional built-in OpenCode TUI. Install OpenCode separately, then select it
# from the page assistant. The default value is resolved through PATH.
HETERO_OPENCODE_BIN="opencode"
# Optional custom adapter catalog; see docs/agent_framework_adapter_guide.md.
HETERO_AGENT_CLI_CONFIG=""
HETERO_KIMI_SERVER_URL="http://127.0.0.1:58627"
HETERO_KIMI_SERVER_TOKEN_FILE="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/state/kimi-code/server.token"
HETERO_KIMI_BIN="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/assets/kimi-code/bin/kimi"
HETERO_KIMI_AUTO_START="1"
HETERO_KIMI_THINKING="medium"
HETERO_KIMI_REQUEST_TIMEOUT_SECONDS="1800"
HETERO_KIMI_STRUCTURED_IDLE_TIMEOUT_SECONDS="120"
HETERO_STARTUP_TIMEOUT_SECONDS="120"
HETERO_STARTUP_HEARTBEAT_SECONDS="5"
HETERO_STARTUP_POLL_SECONDS="1"
KIMI_CODE_HOME="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/state/kimi-code"
KIMI_DISABLE_TELEMETRY="1"
# Optional administrator-managed provider configuration. When omitted, users
# can supply a browser-local override from the page assistant settings.
# KIMI_MODEL_BASE_URL="https://api.kimi.com/coding/v1"
# KIMI_MODEL_NAME="kimi-for-coding"
# KIMI_MODEL_API_KEY="replace-in-the-permission-0600-runtime-platform.env"
# KIMI_MODEL_MAX_CONTEXT_SIZE="262144"
# KIMI_MODEL_PROVIDER_TYPE="kimi"

HETERO_PLATFORM_INTERNAL_URL="http://127.0.0.1:8006"
HETERO_WORKBENCH_URL="http://127.0.0.1:4032"
HETERO_NEXT_API_PROXY_TARGET="http://127.0.0.1:8006"
HETERO_ACCESS_MODE="remote"
HETERO_API_HOST="127.0.0.1"
HETERO_API_PORT="8006"
# Keep this above the Web proxy's pooled-connection lifetime so Next.js never
# reuses an API socket that Uvicorn has already retired.
HETERO_API_KEEP_ALIVE_SECONDS="75"
# Bound deploy/restart latency even when an obsolete browser tab still owns a
# compatibility stream. Agent Runs and PTY sessions remain durable.
HETERO_API_GRACEFUL_SHUTDOWN_SECONDS="6"
HETERO_ASYNC_POLL_MAX_HOLD_MILLISECONDS="250"
HETERO_COMPATIBILITY_SSE_MAX_SECONDS="5"
HETERO_WEB_HOST="0.0.0.0"
HETERO_WEB_PORT="4032"
NEXT_TELEMETRY_DISABLED="1"

TMPDIR="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/tmp"
XDG_CACHE_HOME="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/cache/xdg"
PIP_CACHE_DIR="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/cache/pip"
NPM_CONFIG_CACHE="/home/your-user/work/heterogeneous-enable-web/heterogeneous-enable-web-runtime/cache/npm"

# The lightweight install uses the platform's fixed action surface but does not
# install a privileged process/network sandbox wrapper.
HETERO_BUILD_REQUIRE_NETWORK_SANDBOX="0"
HETERO_BUILD_SANDBOX_PREFIX=""
HETERO_BUILD_SANDBOX_NETWORK_ISOLATED="0"
