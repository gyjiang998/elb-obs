listener_pids_for_port() {
    local port="$1"
    "$PYTHON_BIN" - "$port" <<'PY'
import os
import sys
from pathlib import Path

port = int(sys.argv[1])
uid = os.getuid()
proc_root = Path(os.environ.get("HETERO_PROC_ROOT", "/proc"))
socket_inodes: set[str] = set()
for table in (proc_root / "net" / "tcp", proc_root / "net" / "tcp6"):
    try:
        lines = table.read_text(encoding="ascii").splitlines()[1:]
    except OSError:
        continue
    for line in lines:
        fields = line.split()
        if len(fields) < 10 or fields[3] != "0A":
            continue
        try:
            local_port = int(fields[1].rsplit(":", 1)[1], 16)
            socket_uid = int(fields[7])
        except (IndexError, ValueError):
            continue
        if local_port == port and socket_uid == uid:
            socket_inodes.add(fields[9])

if not socket_inodes:
    raise SystemExit(0)

pids: set[int] = set()
for process_dir in proc_root.glob("[0-9]*"):
    try:
        pid = int(process_dir.name)
        os.kill(pid, 0)
        if process_dir.stat().st_uid != uid:
            continue
        for descriptor in (process_dir / "fd").iterdir():
            try:
                target = os.readlink(descriptor)
            except OSError:
                continue
            if target.startswith("socket:[") and target[8:-1] in socket_inodes:
                pids.add(pid)
                break
    except (OSError, ValueError):
        continue

for pid in sorted(pids):
    print(pid)
PY
}

stop_reserved_port_listeners() {
    local service="$1"
    local port="$2"
    local listener_pids=""
    local remaining_pids=""
    local pid
    local cwd
    local command_line
    local proc_root="${HETERO_PROC_ROOT:-/proc}"
    local pids=()
    listener_pids="$(listener_pids_for_port "$port")"
    if [[ -z "$listener_pids" ]]; then
        case "$(listener_scope_for_port "$port")" in
            none|unknown)
                echo "${service}: reserved port ${port} is free"
                return 0
                ;;
            *)
                echo "${service}: port ${port} remains occupied, but no current-user listener PID is accessible." >&2
                return 1
                ;;
        esac
    fi
    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
    done <<<"$listener_pids"
    for pid in "${pids[@]}"; do
        cwd="$(cd "${proc_root}/${pid}/cwd" 2>/dev/null && pwd -P || true)"
        if [[ -r "${proc_root}/${pid}/cmdline" ]]; then
            command_line="$(tr '\0' ' ' <"${proc_root}/${pid}/cmdline" 2>/dev/null || true)"
        else
            command_line="unknown"
        fi
        echo "${service}: stopping reserved port ${port} listener pid=${pid} cwd=${cwd:-unknown} command=${command_line:0:240}"
    done
    kill -TERM "${pids[@]}" 2>/dev/null || true
    for _ in {1..30}; do
        remaining_pids="$(listener_pids_for_port "$port")"
        if [[ -z "$remaining_pids" ]]; then
            echo "${service}: reserved port ${port} released"
            return 0
        fi
        sleep 0.1
    done
    pids=()
    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
    done <<<"$remaining_pids"
    if [[ ${#pids[@]} -gt 0 ]]; then
        echo "${service}: forcing ${#pids[@]} listener process(es) off reserved port ${port}" >&2
        kill -KILL "${pids[@]}" 2>/dev/null || true
    fi
    for _ in {1..10}; do
        [[ -z "$(listener_pids_for_port "$port")" ]] && {
            echo "${service}: reserved port ${port} released after force stop"
            return 0
        }
        sleep 0.1
    done
    echo "${service}: failed to release reserved port ${port}" >&2
    return 1
}

