    shift 2
    local status=0
    begin_install_operation "$label" "$@"
    if "$@" >"$output_file"; then
        status=0
    else
        status="$?"
    fi
    if [[ "$status" -eq 0 ]]; then
        finish_install_operation
    fi
    return "$status"
}

run_install_stage() {
    local position="$1"
    local label="$2"
    shift 2
    local slow_operation_seconds="${HETERO_INSTALL_SLOW_OPERATION_SECONDS:-60}"
    local heartbeat_seconds="${HETERO_INSTALL_HEARTBEAT_SECONDS:-60}"
    local monitor_poll_seconds="${HETERO_INSTALL_MONITOR_POLL_SECONDS:-5}"
    [[ "$slow_operation_seconds" =~ ^[1-9][0-9]*$ ]] || slow_operation_seconds=60
    [[ "$heartbeat_seconds" =~ ^[1-9][0-9]*$ ]] || heartbeat_seconds=60
    [[ "$monitor_poll_seconds" =~ ^[1-9][0-9]*$ ]] || monitor_poll_seconds=5
    local started_at
    local command_pid
    local monitor_pid
    local operation_file="${TMP_DIR}/install-operation-$$-${position//\//_}.status"
    local stage_command=""
    local status=0
    local failed_operation_started=""
    local failed_operation_label=""
    local failed_operation_command=""
    stage_command="$(render_cli_command "$@")"
    started_at="$(date +%s)"
    echo
    echo "==> [${position}] ${label}，开始于 $(date '+%Y-%m-%d %H:%M:%S')"
    export HETERO_INSTALL_OPERATION_FILE="$operation_file"
    export HETERO_INSTALL_STAGE_LABEL="$label"
    export HETERO_INSTALL_STAGE_COMMAND="$stage_command"
    record_install_operation "$label" "$stage_command"
    (
        cd "$APP_ROOT"
        "$@"
    ) &
    command_pid="$!"
    (
        local operation_started=""
        local operation_label=""
        local operation_command=""
        local operation_elapsed=0
        local operation_key=""
        local last_report_key=""
        local last_report_at=0
        local now=0
        while kill -0 "$command_pid" 2>/dev/null; do
            sleep "$monitor_poll_seconds"
            kill -0 "$command_pid" 2>/dev/null || break
            operation_started=""
            operation_label=""
            operation_command=""
            if [[ -r "$operation_file" ]]; then
                IFS=$'\t' read -r operation_started operation_label operation_command <"$operation_file" || true
            fi
            [[ "$operation_started" =~ ^[0-9]+$ ]] || continue
            [[ -n "$operation_label" ]] || operation_label="$label"
            now="$(date +%s)"
            operation_elapsed=$(( now - operation_started ))
            operation_key="${operation_started}:${operation_label}"
            if (( operation_elapsed >= slow_operation_seconds )) &&
                { [[ "$operation_key" != "$last_report_key" ]] || (( now - last_report_at >= heartbeat_seconds )); }; then
                echo "    [${position}] 当前操作：${operation_label}；已执行 ${operation_elapsed} 秒，仍在运行 (pid ${command_pid})"
                if [[ -n "$operation_command" ]]; then
                    echo "        CLI: ${operation_command}"
                fi
                last_report_key="$operation_key"
                last_report_at="$now"
            fi
        done
    ) &
    monitor_pid="$!"
    wait "$command_pid" || status="$?"
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
    if [[ "$status" -ne 0 && -r "$operation_file" ]]; then
        IFS=$'\t' read -r failed_operation_started failed_operation_label failed_operation_command <"$operation_file" || true
    fi
    rm -f "$operation_file"
    unset HETERO_INSTALL_OPERATION_FILE HETERO_INSTALL_STAGE_LABEL HETERO_INSTALL_STAGE_COMMAND
    if [[ "$status" -ne 0 ]]; then
        echo "<== [${position}] ${label}失败，退出码 ${status}，用时 $(( $(date +%s) - started_at )) 秒" >&2
        if [[ -n "$failed_operation_label" ]]; then
            echo "    失败操作：${failed_operation_label}" >&2
        fi
        if [[ -n "$failed_operation_command" ]]; then
            echo "    CLI: ${failed_operation_command}" >&2
        fi
        return "$status"
    fi
    echo "<== [${position}] ${label}完成，用时 $(( $(date +%s) - started_at )) 秒"
}

