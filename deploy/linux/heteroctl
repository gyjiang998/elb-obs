install_runtime() {
    resolve_python_bin
    check_python_version
    initialize_runtime
    load_environment
    validate_environment_paths
    if [[ "$DEPLOYMENT_MODE" != "worker" ]]; then
        require_command node
        require_command npm
        require_command curl
        check_node_version
    fi
    local running_services=()
    local active_repository_processes=()
    local service
    for service in web api kimi; do
        if pid_alive "$service"; then
            running_services+=("${service}(pid=${PID_RECORD_PID})")
        fi
    done
    if [[ ${#running_services[@]} -gt 0 ]]; then
        echo "Install refused while this runtime is active: ${running_services[*]}." >&2
        echo "Stop it first so .next, node_modules and .venv cannot be replaced underneath running processes:" >&2
        echo "  ${APP_ROOT}/deploy/linux/heteroctl stop --runtime-root \"${RUNTIME_ROOT}\"" >&2
        exit 1
    fi
    while IFS= read -r active_process; do
        [[ -n "$active_process" ]] && active_repository_processes+=("$active_process")
    done < <(active_app_runtime_processes)
    if [[ ${#active_repository_processes[@]} -gt 0 ]]; then
        echo "Install refused because the repository is still used by active platform/build processes:" >&2
        printf '  %s\n' "${active_repository_processes[@]}" >&2
        echo "Stop the older deployment, including deployments that use another runtime root, before installing." >&2
        exit 1
    fi
    export TMPDIR="$TMP_DIR"
    export NEXT_TELEMETRY_DISABLED=1

    if [[ "$SKIP_PYTHON_DEPS" -eq 0 ]]; then
        run_install_stage "1/5" "Python 环境与依赖" install_python_dependencies
    else
        validate_managed_virtualenv || {
            echo "--skip-python-deps requires a compatible existing .venv." >&2
            exit 1
        }
        skip_install_stage "1/5" "Python 环境与依赖" "--skip-python-deps"
    fi
    if [[ -n "$SDK_SOURCE_ROOT" && "$DEPLOYMENT_MODE" != "analysis" ]]; then
        run_install_stage "1a/5" "OpenHarmony 紧凑 SDK 与 musl 头文件" provision_sdk_bundle
    fi
    prepare_optional_pmu_sampler
    if [[ "$DEPLOYMENT_MODE" == "worker" ]]; then
        local configured_runtime_library_root="${REQUESTED_RUNTIME_LIBRARY_ROOT:-${HETERO_RUNTIME_LIBRARY_ROOT:-}}"
        if [[ -n "$configured_runtime_library_root" ]]; then
            register_runtime_library_source "$configured_runtime_library_root"
        fi
        run_install_stage "2/2" "Worker 资源预检" run_deployment_preflight
        echo
        echo "Rootless Worker installation ready."
        echo "Deployment mode: ${DEPLOYMENT_MODE}"
        echo "Runtime: ${RUNTIME_ROOT}"
        echo "Start:   ${APP_ROOT}/deploy/linux/heteroctl start --runtime-root \"${RUNTIME_ROOT}\""
        return 0
    fi
    if [[ "$SKIP_KIMI" -eq 0 ]]; then
        run_install_stage "2/5" "Kimi Code Agent Engine" install_kimi_code
    else
        skip_install_stage "2/5" "Kimi Code Agent Engine" "--skip-kimi"
    fi
    run_install_stage "2a/5" "Agent Adapter 配置预检" validate_agent_cli_configuration 1
    if [[ "$SKIP_WEB_DEPS" -eq 0 ]]; then
        run_install_stage "3/5" "Web 前端依赖" install_web_dependencies
    else
        [[ -x "${APP_ROOT}/node_modules/.bin/next" ]] || { echo "--skip-web-deps requires node_modules" >&2; exit 1; }
        skip_install_stage "3/5" "Web 前端依赖" "--skip-web-deps"
    fi

    if [[ "$SKIP_BUILD" -eq 0 ]]; then
        run_install_stage "4/5" "Next.js 生产构建" build_production_web
        run_install_stage "5/5" "部署预检" run_deployment_preflight
    else
        skip_install_stage "4/5" "Next.js 生产构建" "--skip-build"
        skip_install_stage "5/5" "部署预检" "--skip-build"
        check_deployment_resources
        echo "Skipped the production Web build; run install again without --skip-build before start."
    fi

    if [[ ! -x "${HETERO_KIMI_BIN}" ]]; then
        echo "Kimi Code is not installed at ${HETERO_KIMI_BIN}. Core UI/API can run, but Agent features remain unavailable."
    fi
    echo
    echo "Rootless installation ready."
    echo "Deployment mode: ${DEPLOYMENT_MODE}"
    echo "Runtime: ${RUNTIME_ROOT}"
    echo "Start:   ${APP_ROOT}/deploy/linux/heteroctl start --runtime-root \"${RUNTIME_ROOT}\""
}

start_runtime() {
    make_runtime_root
    set_paths
    validate_planned_paths
    mkdir -p "$LOG_DIR" "$PID_DIR" "$CACHE_DIR/pip" "$CACHE_DIR/npm" "$CACHE_DIR/xdg" "$TMP_DIR"
    local restart_api_for_resources=0
    normalize_requested_resource_overrides
    if [[ -n "$REQUESTED_ACCESS_MODE" && -f "$ENV_FILE" ]]; then
        update_environment_access_mode "$REQUESTED_ACCESS_MODE"
    fi
    if [[ -n "$REQUESTED_WEB_PORT" && -f "$ENV_FILE" ]]; then
        update_environment_web_port "$REQUESTED_WEB_PORT"
    fi
    if [[ -f "$ENV_FILE" ]]; then
        local resource_changes=""
        resource_changes="$(persist_requested_resource_overrides)"
        if [[ -n "$resource_changes" ]]; then
            restart_api_for_resources=1
            echo "Updated resource environment in ${ENV_FILE}: ${resource_changes}"
        fi
    fi
    load_environment
    validate_environment_paths
    require_command curl
    validate_managed_virtualenv
    prepare_optional_pmu_sampler
    local configured_runtime_library_root="${REQUESTED_RUNTIME_LIBRARY_ROOT:-${HETERO_RUNTIME_LIBRARY_ROOT:-}}"
    if [[ -n "$configured_runtime_library_root" && "$DEPLOYMENT_MODE" != "analysis" ]]; then
        register_runtime_library_source "$configured_runtime_library_root"
    fi
    if [[ "$DEPLOYMENT_MODE" == "worker" ]]; then
        # Worker startup advertises both analysis and fixed-profile build
        # capabilities. Recheck the complete core + resource contract so an
        # incomplete/stale repository cannot start as a falsely healthy API.
        run_deployment_preflight --require-trace --require-build
        if [[ "$restart_api_for_resources" -eq 1 ]] && pid_alive api; then
            echo "api: restarting to apply resource environment"
            stop_owned_process api
        fi
        stop_owned_process web
        cleanup_stale_agent_cli_processes
        stop_owned_process kimi
        prepare_api_listener
        if pid_alive api && api_ready; then
            echo "api: ready (owned pid ${PID_RECORD_PID})"
        else
            local worker_api_keep_alive_seconds
            local worker_api_graceful_shutdown_seconds
            worker_api_keep_alive_seconds="$(startup_positive_integer "${HETERO_API_KEEP_ALIVE_SECONDS:-75}" 75)"
            worker_api_graceful_shutdown_seconds="$(startup_positive_integer "${HETERO_API_GRACEFUL_SHUTDOWN_SECONDS:-6}" 6)"
            start_owned_process api "${APP_ROOT}/.venv/bin/python" -m uvicorn backend.app:app \
                --host "${HETERO_API_HOST:-127.0.0.1}" --port "${HETERO_API_PORT:-8006}" --workers 1 \
                --timeout-keep-alive "$worker_api_keep_alive_seconds" \
                --timeout-graceful-shutdown "$worker_api_graceful_shutdown_seconds"
            wait_ready api api_ready api
        fi
        echo
        echo "Worker API: http://127.0.0.1:${HETERO_API_PORT:-8006} (SSH-local access)"
        echo "Worker mode does not start Web, Kimi or server-side device services."
        return 0
    fi
    validate_agent_cli_configuration 1
    require_command node
    [[ -x "${APP_ROOT}/node_modules/.bin/next" ]] || { echo "Next.js is missing; run install." >&2; exit 1; }
    [[ -f "${APP_ROOT}/.next/BUILD_ID" ]] || { echo "Production Web build is missing; run install." >&2; exit 1; }
    check_deployment_resources
    "${APP_ROOT}/.venv/bin/python" -m backend.tools.validate_next_build --build-dir "${APP_ROOT}/.next" || {
        echo "Production Web build is incomplete; rebuild it before start:" >&2
        echo "  ${APP_ROOT}/deploy/linux/heteroctl install --skip-deps --runtime-root \"${RUNTIME_ROOT}\"" >&2
        exit 1
    }
    local stale_source
    stale_source="$(stale_web_build_source)"
    if [[ -n "$stale_source" ]]; then
        echo "Production Web build is stale; newer source detected: ${stale_source}" >&2
        echo "Rebuild without reinstalling dependencies: ${APP_ROOT}/deploy/linux/heteroctl install --skip-deps --runtime-root \"${RUNTIME_ROOT}\"" >&2
        exit 1
    fi
    if [[ "$restart_api_for_resources" -eq 1 ]] && pid_alive api; then
        echo "api: restarting to apply resource environment"
        stop_owned_process api
    fi
    prepare_web_listener
    prepare_api_listener

    if pid_alive api && api_ready; then
        echo "api: ready (owned pid ${PID_RECORD_PID})"
    else
        # An API that was force-killed cannot execute its FastAPI shutdown
        # hook. Reclaim only process groups whose cwd proves that they belong
        # to this runtime's projected Agent workspaces.
        cleanup_stale_agent_cli_processes
        local api_keep_alive_seconds
        local api_graceful_shutdown_seconds
        api_keep_alive_seconds="$(startup_positive_integer "${HETERO_API_KEEP_ALIVE_SECONDS:-75}" 75)"
        api_graceful_shutdown_seconds="$(startup_positive_integer "${HETERO_API_GRACEFUL_SHUTDOWN_SECONDS:-6}" 6)"
        start_owned_process api "${APP_ROOT}/.venv/bin/python" -m uvicorn backend.app:app \
            --host "${HETERO_API_HOST:-127.0.0.1}" --port "${HETERO_API_PORT:-8006}" --workers 1 \
            --timeout-keep-alive "$api_keep_alive_seconds" \
            --timeout-graceful-shutdown "$api_graceful_shutdown_seconds"
        wait_ready api api_ready api
    fi
    if [[ -x "${HETERO_KIMI_BIN}" ]]; then
        wait_ready kimi kimi_ready api
        verify_agent_tool_policy
        echo "kimi: backend-managed Agent Engine service is ready; backend model configuration is used unless the Web UI supplies an override"
    else
        echo "kimi: unavailable (${HETERO_KIMI_BIN} not found)"
    fi

    if pid_alive web && web_ready; then
        echo "web: ready (owned pid ${PID_RECORD_PID})"
    else
        start_owned_process web node "${APP_ROOT}/tools/serve-platform.mjs" \
            --hostname "${HETERO_WEB_HOST:-127.0.0.1}" --port "${HETERO_WEB_PORT:-4032}"
        if ! wait_ready web web_ready web; then
            web_static_assets_diagnostic "http://127.0.0.1:${HETERO_WEB_PORT:-4032}" || true
            return 1
        fi
    fi
    wait_ready web-api-proxy web_api_proxy_ready web api
    if ! wait_ready browser-bootstrap web_bootstrap_ready web api; then
        echo "Browser bootstrap failed; inspect both ${LOG_DIR}/web.log and ${LOG_DIR}/api.log." >&2
        return 1
    fi

    echo
    if [[ "$HETERO_ACCESS_MODE" == "remote" ]]; then
        echo "Access mode: remote"
        echo "Workbench: $(workbench_url)"
        echo "Expected network boundary: only the Web UI is exposed. Browser /v1 requests are proxied internally; FastAPI and Kimi intentionally remain on 127.0.0.1."
    else
        echo "Access mode: local"
        echo "Workbench: http://127.0.0.1:${HETERO_WEB_PORT:-4032}"
    fi
}

stop_runtime() {
    make_runtime_root
    set_paths
    validate_planned_paths
    mkdir -p "$PID_DIR"
    load_environment
    validate_environment_paths
    stop_owned_process web
    stop_owned_process api
    cleanup_stale_agent_cli_processes
    stop_owned_process kimi
    if [[ "$OWNED_ONLY_STOP" -eq 0 ]]; then
        local stop_failed=0
        stop_reserved_port_listeners api "${HETERO_API_PORT:-8006}" || stop_failed=1
        if [[ "$DEPLOYMENT_MODE" != "worker" ]]; then
            stop_reserved_port_listeners web "${HETERO_WEB_PORT:-4032}" || stop_failed=1
            stop_reserved_port_listeners kimi "${HETERO_KIMI_SERVER_PORT:-58627}" || stop_failed=1
        fi
        cleanup_stale_agent_cli_processes || stop_failed=1
        return "$stop_failed"
    fi
}

status_line() {
    local name="$1"
    local check="$2"
    local ownership="not-owned"
    if pid_alive "$name"; then
        ownership="owned pid=${PID_RECORD_PID}"
    fi
    if "$check"; then
        echo "${name}: ready (${ownership})"
    else
        echo "${name}: unavailable (${ownership})"
    fi
}

resource_path_status_line() {
    local name="$1"
    local path="$2"
    local expected="$3"
    local ready=0
    case "$expected" in
        executable) [[ -n "$path" && -f "$path" && -x "$path" ]] && ready=1 ;;
        directory) [[ -n "$path" && -d "$path" ]] && ready=1 ;;
    esac
    if [[ "$ready" -eq 1 ]]; then
        echo "${name}: ready (${path})"
    else
        echo "${name}: unavailable (${path:-not-configured})"
    fi
}

status_runtime() {
    make_runtime_root
    set_paths
    load_environment
    validate_environment_paths
    require_command curl
    echo "deployment-mode: ${DEPLOYMENT_MODE}"
    if [[ -x "${APP_ROOT}/.venv/bin/python" ]]; then
        echo "python-runtime: Python $(python_version_string "${APP_ROOT}/.venv/bin/python") ($(python_base_executable_identity "${APP_ROOT}/.venv/bin/python"))"
    else
        echo "python-runtime: unavailable (${APP_ROOT}/.venv/bin/python)"
    fi
    status_line api api_ready
    if [[ "$DEPLOYMENT_MODE" == "worker" ]]; then
        echo "kimi: disabled (worker deployment)"
        echo "web: disabled (worker deployment)"
    else
        status_line kimi kimi_ready
        status_line web web_ready
        status_line web-api-proxy web_api_proxy_ready
        status_line browser-bootstrap web_bootstrap_ready
    fi
    if [[ "$DEPLOYMENT_MODE" == "analysis" ]]; then
        echo "device-validation: disabled (analysis deployment; resource checks skipped)"
    else
        [[ "$DEPLOYMENT_MODE" != "worker" ]] || echo "device-validation: disabled (worker deployment; Desktop owns HDC/PMU/Bridge)"
        local llvm_root="${HETERO_LLVM_BIN_ROOT:-}"
        if [[ -n "$llvm_root" && -x "${llvm_root}/clang" && -x "${llvm_root}/clang++" && -x "${llvm_root}/ld.lld" ]]; then
            echo "llvm-toolchain: ready (${llvm_root})"
        else
            echo "llvm-toolchain: unavailable (${llvm_root:-not-configured})"
        fi
        resource_path_status_line glslang "${HETERO_GLSLANG_BIN:-}" executable
        resource_path_status_line trace-streamer "${HETERO_TRACE_STREAMER:-}" executable
        resource_path_status_line openharmony-sdk "${HETERO_OPENHARMONY_SDK_ROOT:-}" directory
        if [[ -n "${HETERO_RUNTIME_LIBRARY_ROOT:-${HETERO_BUILD_RUNTIME_LIBRARY_ROOT:-}}" ]]; then
            resource_path_status_line runtime-libraries "${HETERO_RUNTIME_LIBRARY_ROOT:-${HETERO_BUILD_RUNTIME_LIBRARY_ROOT:-}}" directory
        fi
        if [[ "$DEPLOYMENT_MODE" == "device" && -n "${HETERO_HDC_BIN:-}" ]]; then
            resource_path_status_line hdc "${HETERO_HDC_BIN}" executable
        fi
    fi
    echo "web-listener: $(web_listener_scope) (expected ${HETERO_ACCESS_MODE})"
    if [[ "$HETERO_ACCESS_MODE" == "remote" ]]; then
        echo "access: remote ($(workbench_url))"
    else
        echo "access: local (http://127.0.0.1:${HETERO_WEB_PORT:-4032})"
    fi
}

http_diagnostic_probe() {
    local label="$1"
    local method="$2"
    local url="$3"
    local body="${4:-}"
    local output_file="${TMP_DIR}/doctor-${label//[^A-Za-z0-9_.-]/_}.$$.txt"
    local status="000"
    if [[ "$method" == "POST" ]]; then
        status="$(curl --noproxy '*' --max-time 15 -sS -o "$output_file" -w '%{http_code}' \
            -H "Content-Type: application/json" --data "$body" "$url" 2>/dev/null || true)"
    else
        status="$(curl --noproxy '*' --max-time 15 -sS -o "$output_file" -w '%{http_code}' "$url" 2>/dev/null || true)"
    fi
    if [[ "$status" =~ ^2[0-9][0-9]$ ]]; then
        echo "[OK] ${label}: HTTP ${status}"
        rm -f "$output_file"
        return 0
    fi
    echo "[FAIL] ${label}: HTTP ${status}"
    if [[ -s "$output_file" ]]; then
        head -c 1200 "$output_file"
        echo
    fi
    rm -f "$output_file"
    return 1
}

agent_engine_diagnostic() {
    local web="$1"
    local output_file="${TMP_DIR}/doctor-agent-engine.$$.json"
    local status="000"
    local summary=""
    local parse_status=0
    status="$(curl --noproxy '*' --max-time 15 -sS -o "$output_file" -w '%{http_code}' \
        "${web}/v1/agent-engine/health" 2>/dev/null || true)"
    if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then
        echo "[FAIL] agent-engine-via-web: HTTP ${status}"
        [[ -s "$output_file" ]] && { head -c 1200 "$output_file"; echo; }
        rm -f "$output_file"
        return 1
    fi
    if summary="$("${APP_ROOT}/.venv/bin/python" - "$output_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    root = json.load(stream)
engine = root.get("engine") if isinstance(root, dict) else {}
engine = engine if isinstance(engine, dict) else {}
status = str(engine.get("status") or "unknown")
service = str(engine.get("service_status") or "unknown")
model = str(engine.get("model_status") or "unknown")
credential = str(engine.get("credential_mode") or "none")
error = engine.get("error") if isinstance(engine.get("error"), dict) else {}
error_code = str(error.get("code") or "")
policy = engine.get("tool_policy") if isinstance(engine.get("tool_policy"), dict) else {}
disabled = set(policy.get("disabled_tools") or [])
native = set(policy.get("native_backend_tools") or [])
required_native = {"Bash", "Read", "Edit", "Glob", "Grep"}
policy_ready = (
    policy.get("backend_control") == "kimi_native_tools"
    and disabled == {"FetchURL", "WebSearch"}
    and required_native.issubset(native)
    and policy.get("web_search_enabled") is False
    and policy.get("web_fetch_enabled") is False
)
print(
    f"service={service}, model={model}, credential={credential}, status={status}, "
    f"tool_policy={'ready' if policy_ready else 'invalid'}"
    + (f", error={error_code}" if error_code else "")
)
if service != "ready":
    raise SystemExit(1)
if not policy_ready:
    raise SystemExit(1)
if model != "ready":
    raise SystemExit(3)
PY
)"; then
        parse_status=0
    else
        parse_status=$?
    fi
    rm -f "$output_file"
    if [[ "$parse_status" -eq 0 ]]; then
        echo "[OK] agent-engine-via-web: ${summary}"
        return 0
    fi
    if [[ "$parse_status" -eq 3 ]]; then
        echo "[WARN] agent-engine-via-web: ${summary}; configure a backend model or save one in the Web UI"
        return 0
    fi
    echo "[FAIL] agent-engine-via-web: ${summary}"
    return 1
}

web_static_assets_diagnostic() {
    local web="$1"
    local html_file="${TMP_DIR}/doctor-web-root.$$.html"
    local asset_file="${TMP_DIR}/doctor-web-assets.$$.txt"
    local asset_path
    local status
    local content_type
    local metadata
    local asset_valid
    local count=0
    local failed=0
    if ! curl --noproxy '*' --max-time 15 -fsS "${web}/" -o "$html_file"; then
        echo "[FAIL] next-static-assets: unable to read the current HTML document"
        rm -f "$html_file" "$asset_file"
        return 1
    fi
    extract_next_static_asset_paths "$html_file" >"$asset_file" || true
    if [[ ! -s "$asset_file" ]]; then
        echo "[FAIL] next-static-assets: current HTML contains no Next.js static asset references"
        rm -f "$html_file" "$asset_file"
        return 1
    fi
    while IFS= read -r asset_path; do
        [[ -n "$asset_path" ]] || continue
        count=$((count + 1))
        metadata="$(curl --noproxy '*' --max-time 15 -sS -o /dev/null \
            -w $'%{http_code}\t%{content_type}' "${web}${asset_path}" 2>/dev/null || true)"
        IFS=$'\t' read -r status content_type <<<"$metadata"
        asset_valid=1
        [[ "$status" =~ ^2[0-9][0-9]$ ]] || asset_valid=0
        case "${asset_path%%\?*}" in
            *.js) [[ "$content_type" == *javascript* ]] || asset_valid=0 ;;
            *.css) [[ "$content_type" == text/css* ]] || asset_valid=0 ;;
        esac
        if [[ "$asset_valid" -ne 1 ]]; then
            echo "[FAIL] next-static-asset: HTTP ${status:-000} content-type=${content_type:-missing} ${asset_path}"
            failed=1
        fi
    done <"$asset_file"
    rm -f "$html_file" "$asset_file"
    if [[ "$failed" -ne 0 ]]; then
        return 1
    fi
    echo "[OK] next-static-assets: ${count} current HTML assets"
}

doctor_runtime() {
    make_runtime_root
    set_paths
    load_environment
    validate_environment_paths
    validate_agent_cli_configuration 1
    require_command curl
    mkdir -p "$TMP_DIR" "$LOG_DIR"
    local web="http://127.0.0.1:${HETERO_WEB_PORT:-4032}"
    local api="http://127.0.0.1:${HETERO_API_PORT:-8006}"
    local failed=0
    http_diagnostic_probe "web-root" GET "${web}/" || failed=1
    web_static_assets_diagnostic "$web" || failed=1
    http_diagnostic_probe "api-health-direct" GET "${api}/v1/health" || failed=1
    http_diagnostic_probe "api-health-via-web" GET "${web}/v1/health" || failed=1
    http_diagnostic_probe "platform-version-via-web" GET "${web}/v1/platform-version" || failed=1
    agent_engine_diagnostic "$web" || failed=1
    http_diagnostic_probe "agent-adapters-direct" GET "${api}/v1/agent-cli/adapters" || failed=1
    http_diagnostic_probe "agent-adapters-via-web" GET "${web}/v1/agent-cli/adapters" || failed=1
    http_diagnostic_probe "overview-via-web" GET "${web}/v1/overview" || failed=1
    http_diagnostic_probe "page-actions-via-web" GET "${web}/v1/page-actions" || failed=1
    http_diagnostic_probe "optimization-kb-via-web" POST "${web}/v1/optimization-kb/search" \
        '{"query":"","include_unverified":false,"include_cases":false}' || failed=1
    http_diagnostic_probe "hardware-kb-via-web" POST "${web}/v1/hardware-kb/search" \
        '{"query":"","include_unverified":true,"include_cases":false}' || failed=1
    if [[ "$failed" -ne 0 ]]; then
        echo
        echo "Recent Web errors:"
        [[ -f "${LOG_DIR}/web.log" ]] && tail -n 120 "${LOG_DIR}/web.log" || echo "(no web.log)"
        echo
        echo "Recent API errors:"
        [[ -f "${LOG_DIR}/api.log" ]] && tail -n 120 "${LOG_DIR}/api.log" || echo "(no api.log)"
        return 1
    fi
    echo "Browser bootstrap diagnostics passed."
}

