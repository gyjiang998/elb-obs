register_runtime_library_source() {
    local selected_library_root="$1"
    [[ -d "$selected_library_root" ]] || {
        echo "Runtime library root is not a directory: $selected_library_root" >&2
        return 2
    }
    local python_bin="${APP_ROOT}/.venv/bin/python"
    if [[ ! -x "$python_bin" ]]; then
        resolve_python_bin
        python_bin="$PYTHON_BIN"
    fi
    (
        cd "$APP_ROOT"
        "$python_bin" -m backend.tools.configure_runtime_library_source \
            --library-root "$selected_library_root" \
            --state-root "$HETERO_STATE_ROOT"
    )
}

configure_runtime_libraries() {
    local selected_library_root="${RUNTIME_LIBRARY_ROOT:-${REQUESTED_RUNTIME_LIBRARY_ROOT:-$SDK_SOURCE_ROOT}}"
