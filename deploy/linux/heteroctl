process_start_time() {
    local pid="$1"
    local stat_line remainder
    [[ -r "/proc/${pid}/stat" ]] || return 1
    stat_line="$(<"/proc/${pid}/stat")"
    remainder="${stat_line##*) }"
    local fields=()
    read -r -a fields <<<"$remainder"
    [[ ${#fields[@]} -gt 19 ]] || return 1
    printf '%s\n' "${fields[19]}"
}

pid_record() {
    local name="$1"
    local pid_file="${PID_DIR}/${name}.pid"
    [[ -f "$pid_file" ]] || return 1
    read -r PID_RECORD_PID PID_RECORD_START <"$pid_file" || return 1
    [[ "$PID_RECORD_PID" =~ ^[0-9]+$ && "$PID_RECORD_START" =~ ^[0-9]+$ ]]
}

pid_process_alive() {
    local name="$1"
    pid_record "$name" || return 1
    kill -0 "$PID_RECORD_PID" 2>/dev/null
}

pid_alive() {
    local name="$1"
    pid_record "$name" || return 1
    kill -0 "$PID_RECORD_PID" 2>/dev/null || return 1
    [[ "$(process_start_time "$PID_RECORD_PID" 2>/dev/null || true)" == "$PID_RECORD_START" ]] || return 1
    local command_line signature
    command_line="$(tr '\0' ' ' <"/proc/${PID_RECORD_PID}/cmdline" 2>/dev/null || true)"
    signature="$(service_signature "$name")"
    [[ -n "$command_line" && "$command_line" == *"$signature"* ]]
}

active_app_runtime_processes() {
    # PID files are scoped to one runtime root, while .next, node_modules and
    # .venv are scoped to the repository. Detect an older deployment that uses
    # the same application tree even when it was started with another runtime.
    local proc_root="${HETERO_PROC_ROOT:-/proc}"
    [[ -d "$proc_root" ]] || return 0
    local process_dir
    local pid
    local cwd
    local command_line
    for process_dir in "$proc_root"/[0-9]*; do
        [[ -d "$process_dir" ]] || continue
        pid="${process_dir##*/}"
        [[ "$pid" != "$$" && "$pid" != "${BASHPID:-$$}" ]] || continue
        cwd="$(cd "${process_dir}/cwd" 2>/dev/null && pwd -P || true)"
        [[ "$cwd" == "$APP_ROOT" ]] || continue
        command_line="$(tr '\0' ' ' <"${process_dir}/cmdline" 2>/dev/null || true)"
        case "$command_line" in
            *"deploy/linux/heteroctl install"*|*"tools/serve-platform.mjs"*|*"node_modules/.bin/next"*|*"next/dist/bin/next"*|*"next-server"*|*"backend.app:app"*|*"npm ci"*|*"npm run build"*|*"next build"*|*"pip install"*)
                printf '%s %s\n' "$pid" "${command_line:0:240}"
                ;;
        esac
    done
}

start_owned_process() {
    local name="$1"
    shift
    if pid_alive "$name"; then
        echo "${name}: already running (pid ${PID_RECORD_PID})"
        return 0
    fi
    rm -f "${PID_DIR}/${name}.pid"
    (
        cd "$APP_ROOT"
        nohup "$@" >>"${LOG_DIR}/${name}.log" 2>&1 </dev/null &
        local child_pid="$!"
        local child_start=""
        for _ in {1..20}; do
            child_start="$(process_start_time "$child_pid" 2>/dev/null || true)"
            [[ -n "$child_start" ]] && break
            sleep 0.05
        done
        if [[ -z "$child_start" ]]; then
            kill "$child_pid" 2>/dev/null || true
            echo "${name}: could not establish Linux process ownership" >&2
            exit 1
        fi
        printf '%s %s\n' "$child_pid" "$child_start" >"${PID_DIR}/${name}.pid"
    )
    local pid _start
    read -r pid _start <"${PID_DIR}/${name}.pid"
    echo "${name}: started (pid ${pid})"
}

stop_owned_process() {
    local name="$1"
    local pid_file="${PID_DIR}/${name}.pid"
    if ! pid_alive "$name"; then
        if pid_process_alive "$name"; then
            echo "${name}: refusing to stop pid ${PID_RECORD_PID}; PID ownership no longer matches this runtime" >&2
        fi
        rm -f "$pid_file"
        echo "${name}: not owned by this runtime"
        return 0
    fi
    local pid="$PID_RECORD_PID"
    kill "$pid" 2>/dev/null || true
    local graceful_checks=40
    [[ "$name" == "api" ]] && graceful_checks=100
    for ((check_index = 0; check_index < graceful_checks; check_index += 1)); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pid_file"
            echo "${name}: stopped"
            return 0
        fi
        sleep 0.1
    done
    if pid_alive "$name"; then
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
    echo "${name}: stopped after timeout"
}

