extract_next_static_asset_paths() {
    "$PYTHON_BIN" - "$1" <<'PY'
import sys
from html.parser import HTMLParser
from urllib.parse import urlsplit


class AssetParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.assets = set()

    def handle_starttag(self, tag, attrs):
        values = dict(attrs)
        value = values.get("src") if tag == "script" else values.get("href") if tag == "link" else None
        if not value:
            return
        parsed = urlsplit(value)
        if not parsed.path.startswith("/_next/static/"):
            return
        suffix = f"?{parsed.query}" if parsed.query else ""
        self.assets.add(f"{parsed.path}{suffix}")


parser = AssetParser()
with open(sys.argv[1], encoding="utf-8") as stream:
    parser.feed(stream.read())
for asset in sorted(parser.assets):
    print(asset)
PY
}

next_static_asset_ready() {
    local url="$1"
    local asset_path="$2"
    local metadata
    local status
    local content_type
    metadata="$(curl --noproxy '*' --connect-timeout 1 --max-time 5 -sS \
        -o /dev/null -w $'%{http_code}\t%{content_type}' "${url}${asset_path}" 2>/dev/null || true)"
    IFS=$'\t' read -r status content_type <<<"$metadata"
    [[ "$status" =~ ^2[0-9][0-9]$ ]] || return 1
    case "${asset_path%%\?*}" in
        *.js) [[ "$content_type" == *javascript* ]] ;;
        *.css) [[ "$content_type" == text/css* ]] ;;
        *) return 0 ;;
    esac
}

