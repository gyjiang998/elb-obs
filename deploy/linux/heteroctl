record_install_operation() {
    local label="$1"
    local cli_command="${2:-}"
    local operation_file="${HETERO_INSTALL_OPERATION_FILE:-}"
    [[ -n "$operation_file" ]] || return 0
    printf '%s\t%s\t%s\n' "$(date +%s)" "$label" "$cli_command" >"$operation_file"
}

begin_install_operation() {
    local label="$1"
    shift
    local cli_command=""
    local working_directory=""
    cli_command="$(render_cli_command "$@")"
    record_install_operation "$label" "$cli_command"
    echo "    操作：${label}"
    if working_directory="$(pwd -P 2>&1)"; then
        echo "        CWD: ${working_directory}"
    else
        echo "        CWD: 无法读取（${working_directory}）" >&2
    fi
    echo "        CLI: ${cli_command}"
}

finish_install_operation() {
    record_install_operation \
        "${HETERO_INSTALL_STAGE_LABEL:-安装阶段收尾}" \
        "${HETERO_INSTALL_STAGE_COMMAND:-}"
}

run_install_operation() {
    local label="$1"
    shift
    local status=0
    begin_install_operation "$label" "$@"
    if "$@"; then
        status=0
    else
        status="$?"
    fi
    if [[ "$status" -eq 0 ]]; then
        finish_install_operation
    fi
    return "$status"
}

run_install_operation_capture() {
    local label="$1"
