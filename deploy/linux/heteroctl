    doctor) doctor_runtime ;;
    python-check) python_check_runtime ;;
    agent-check) agent_check_runtime ;;
    preflight) preflight_runtime ;;
    sdk) provision_sdk ;;
    pmu) provision_pmu_sampler ;;
    runtime-libs) configure_runtime_libraries ;;
    logs) show_logs ;;
    paths) show_paths ;;
