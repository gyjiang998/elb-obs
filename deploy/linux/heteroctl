prepare_web_listener() {
    local scope
    scope="$(web_listener_scope)"
    case "$scope" in
        none)
            return 0
            ;;
        unknown)
            if ! web_http_ready; then
                return 0
            fi
            if pid_alive web; then
                return 0
            fi
            echo "Port ${HETERO_WEB_PORT:-4032} serves HTTP but its listener ownership is unknown; refusing to reuse it." >&2
            return 1
            ;;
    esac
    if pid_alive web; then
        if [[ "$scope" != "$HETERO_ACCESS_MODE" ]]; then
            echo "web: restarting owned ${scope} listener for ${HETERO_ACCESS_MODE} access"
            stop_owned_process web
            return 0
        fi
        if ! web_http_ready || ! web_static_assets_ready; then
            echo "web: restarting an unhealthy owned listener (document or static assets unavailable)"
            stop_owned_process web
        fi
        return 0
    fi
    echo "Port ${HETERO_WEB_PORT:-4032} is occupied by an unowned ${scope} listener; refusing to reuse an older or unrelated Web process." >&2
    echo "Inspect it with: ss -tlnp | grep ':${HETERO_WEB_PORT:-4032}'" >&2
    echo "Stop the owning deployment or choose another HETERO_WEB_PORT, then retry." >&2
    return 1
}

