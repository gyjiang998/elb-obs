    "$PYTHON_BIN" - "$ENV_FILE" "${arguments[@]}" <<'PY'
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
arguments = sys.argv[2:]
values = dict(zip(arguments[0::2], arguments[1::2], strict=True))
seen: set[str] = set()
changed: list[str] = []
updated: list[str] = []
for line in path.read_text(encoding="utf-8").splitlines():
    key, separator, current = line.partition("=")
    if separator and key in values:
        normalized = current.strip()
        if len(normalized) >= 2 and normalized[0] == normalized[-1] and normalized[0] in {'"', "'"}:
            normalized = normalized[1:-1]
        if normalized != values[key]:
            changed.append(key)
        updated.append(f'{key}="{values[key]}"')
        seen.add(key)
    else:
        updated.append(line)
for key, value in values.items():
    if key not in seen:
        updated.append(f'{key}="{value}"')
        changed.append(key)
if not changed:
    raise SystemExit(0)
temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
temporary.write_text("\n".join(updated) + "\n", encoding="utf-8")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
print(",".join(dict.fromkeys(changed)))
PY
}

apply_access_mode() {
    local access_mode="${REQUESTED_ACCESS_MODE:-${HETERO_ACCESS_MODE:-remote}}"
    case "$access_mode" in
        remote)
            HETERO_WEB_HOST="0.0.0.0"
            ;;
        local)
            HETERO_WEB_HOST="127.0.0.1"
            ;;
        *)
            echo "Invalid HETERO_ACCESS_MODE in ${ENV_FILE}: ${access_mode}" >&2
            exit 2
            ;;
    esac
    HETERO_ACCESS_MODE="$access_mode"
    HETERO_WEB_PORT="${HETERO_WEB_PORT:-${DEFAULT_WEB_PORT}}"
    validate_tcp_port "HETERO_WEB_PORT" "$HETERO_WEB_PORT"
    if [[ "$HETERO_WEB_PORT" == "${HETERO_API_PORT:-8006}" ]]; then
        echo "HETERO_WEB_PORT and HETERO_API_PORT cannot both use ${HETERO_WEB_PORT}." >&2
        exit 2
    fi
    # Browser API calls use the Next.js same-origin proxy. Keep the API and
    # model server private even when the Web UI is available on the LAN.
    HETERO_API_HOST="127.0.0.1"
    HETERO_WORKBENCH_URL="http://127.0.0.1:${HETERO_WEB_PORT}"
    HETERO_NEXT_API_PROXY_TARGET="http://127.0.0.1:${HETERO_API_PORT:-8006}"
