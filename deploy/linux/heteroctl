    resolve_python_bin
    if [[ -e "$venv_root" ]]; then
        if [[ ! -x "$venv_python" ]]; then
            recreate_reason="现有 .venv 不包含可执行的 bin/python"
        elif ! python_version_supported "$venv_python"; then
            current_version="$(python_version_string "$venv_python" || true)"
            recreate_reason="现有 .venv 使用 Python ${current_version:-unknown}，不满足 Python 3.11+"
        elif [[ -n "$REQUESTED_PYTHON_BIN" ]]; then
            current_base="$(python_base_executable_identity "$venv_python" || true)"
            selected_base="$(python_executable_identity "$PYTHON_BIN" || true)"
            if [[ -z "$current_base" || -z "$selected_base" || "$current_base" != "$selected_base" ]]; then
                recreate_reason="现有 .venv 的基础解释器为 ${current_base:-unknown}，与显式指定的 ${selected_base:-$PYTHON_BIN} 不同"
            fi
        fi
    fi

    if [[ -n "$recreate_reason" ]]; then
        backup_root="${APP_ROOT}/.venv-python-backup.$$"
        echo "    ${recreate_reason}；将使用 ${PYTHON_BIN} 重建。"
        mv "$venv_root" "$backup_root"
    fi

    if [[ ! -x "$venv_python" ]]; then
        echo "    创建 Python virtual environment: ${venv_root}"
        echo "    基础解释器: ${PYTHON_BIN} (Python ${PYTHON_VERSION})"
        if ! run_install_operation "创建 Python virtual environment" \
            "$PYTHON_BIN" -m venv "$venv_root"; then
            restore_virtualenv_backup "$venv_root" "$backup_root"
            return 1
        fi
    fi
    if ! ensure_virtualenv_pip; then
        restore_virtualenv_backup "$venv_root" "$backup_root"
        return 1
    fi
    if ! run_install_operation "安装 Python 依赖（pip install）" \
        env PIP_CACHE_DIR="$CACHE_DIR/pip" \
        "$venv_python" -m pip install \
            --disable-pip-version-check --timeout 60 --retries 2 \
            -r "${APP_ROOT}/backend/requirements.txt"; then
        restore_virtualenv_backup "$venv_root" "$backup_root"
        return 1
    fi
    [[ -z "$backup_root" ]] || rm -rf -- "$backup_root"
    current_version="$(python_version_string "$venv_python")"
    current_base="$(python_base_executable_identity "$venv_python")"
    echo "    Python virtual environment: ${venv_python} (Python ${current_version}, base ${current_base})"
}

