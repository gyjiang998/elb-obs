    if ! "$python_bin" -m pip --version >/dev/null 2>&1; then
        echo "ensurepip 已返回成功，但 ${python_bin} 仍无法加载 pip；请删除仓库内 .venv 后重新安装。" >&2
        return 1
    fi
}

