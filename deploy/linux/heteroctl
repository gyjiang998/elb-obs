    echo "run=${PID_DIR}"
    echo "cache=${CACHE_DIR}"
    echo "tmp=${TMP_DIR}"
    echo "env=${ENV_FILE}"
}

show_logs() {
    make_runtime_root
    set_paths
    local services=(kimi api web)
    if [[ -n "$LOG_SERVICE" ]]; then
        case "$LOG_SERVICE" in
            kimi|api|web) services=("$LOG_SERVICE") ;;
            *) echo "Unknown service: ${LOG_SERVICE}" >&2; exit 2 ;;
        esac
    fi
    for service in "${services[@]}"; do
        echo "===== ${service}.log ====="
        if [[ "$service" == "kimi" && -f "${STATE_DIR}/kimi-engine/logs/kimi-server.log" ]]; then
            tail -n 100 "${STATE_DIR}/kimi-engine/logs/kimi-server.log"
        elif [[ -f "${LOG_DIR}/${service}.log" ]]; then
            tail -n 100 "${LOG_DIR}/${service}.log"
        else
            echo "(no log)"
        fi
    done
}

