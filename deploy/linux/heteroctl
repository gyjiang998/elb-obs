    echo "    Python virtual environment 中未发现 pip，正在使用 ensurepip 引导。"
    if ! run_install_operation "引导 Python virtual environment 的 pip（ensurepip）" \
        "$python_bin" -m ensurepip --upgrade; then
        echo "当前解释器无法为 virtual environment 提供 pip：${PYTHON_BIN}" >&2
        echo "请为当前 Python 安装完整的 venv/ensurepip 组件，或改用包含 ensurepip 的 Python 3.11+。" >&2
        echo "可先验证：${PYTHON_BIN} -m ensurepip --version" >&2
        echo "Debian/Ubuntu 通常需要与 Python 版本匹配的 python3-venv（例如 python3.11-venv）。" >&2
        echo "修复 Python 后直接重新执行 heteroctl install；无需删除 runtime。" >&2
        return 1
