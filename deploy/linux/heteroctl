}

show_startup_log_tail() {
    local service="$1"
    local log_file="${LOG_DIR}/${service}.log"
    if [[ ! -s "$log_file" ]]; then
        echo "${service}: no startup log was written at ${log_file}" >&2
        return 0
    fi
    echo "${service}: recent startup log (${log_file}):" >&2
    tail -n 40 "$log_file" >&2
}

wait_ready() {
    local name="$1"
    local check="$2"
    shift 2
    local owners=("$@")
    local timeout heartbeat poll
    timeout="$(startup_positive_integer "${HETERO_STARTUP_TIMEOUT_SECONDS:-120}" 120)"
    heartbeat="$(startup_positive_integer "${HETERO_STARTUP_HEARTBEAT_SECONDS:-5}" 5)"
    poll="$(startup_positive_integer "${HETERO_STARTUP_POLL_SECONDS:-1}" 1)"
    local started="$SECONDS"
    local elapsed=0
    local next_heartbeat="$heartbeat"
    local owner latest_log

    echo "${name}: waiting for readiness (timeout ${timeout}s)"
    while (( elapsed < timeout )); do
        if "$check"; then
            elapsed=$((SECONDS - started))
            echo "${name}: ready (${elapsed}s)"
            return 0
        fi
        if [[ ${#owners[@]} -gt 0 ]]; then
            for owner in "${owners[@]}"; do
                if ! pid_alive "$owner"; then
                    echo "${name}: ${owner} process exited before readiness" >&2
                    show_startup_log_tail "$owner"
                    return 1
                fi
            done
        fi
        elapsed=$((SECONDS - started))
        if (( elapsed >= next_heartbeat )); then
            latest_log=""
            if [[ ${#owners[@]} -gt 0 ]]; then
                latest_log="$(latest_service_log_line "${owners[0]}")"
            fi
            if [[ -n "$latest_log" ]]; then
                echo "${name}: still starting (${elapsed}s/${timeout}s); latest log: ${latest_log}"
            else
                echo "${name}: still starting (${elapsed}s/${timeout}s); log: ${LOG_DIR}/${owners[0]:-$name}.log"
            fi
            next_heartbeat=$((elapsed + heartbeat))
        fi
        sleep "$poll"
        elapsed=$((SECONDS - started))
    done

    echo "${name}: readiness timeout after ${elapsed}s" >&2
    if [[ ${#owners[@]} -gt 0 ]]; then
        for owner in "${owners[@]}"; do
            show_startup_log_tail "$owner"
        done
    else
        show_startup_log_tail "$name"
    fi
    return 1
}

