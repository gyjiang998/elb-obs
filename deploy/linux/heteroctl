#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
APP_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

RUNTIME_ROOT="${HETERO_ROOTLESS_RUNTIME_ROOT:-${HETERO_USER_HOME:-${APP_ROOT}/heterogeneous-enable-web-runtime}}"
SKIP_PYTHON_DEPS=0
SKIP_WEB_DEPS=0
SKIP_KIMI=0
SKIP_BUILD=0
REFRESH_ENV=0
REQUESTED_ACCESS_MODE=""
REQUESTED_DEPLOYMENT_MODE="${HETERO_DEPLOYMENT_MODE:-}"
DEPLOYMENT_MODE=""
REQUESTED_WEB_PORT=""
PREFLIGHT_ARGS=()
LOG_SERVICE=""
SDK_SOURCE_ROOT=""
RUNTIME_LIBRARY_ROOT=""
REQUESTED_TRACE_STREAMER="${HETERO_TRACE_STREAMER:-}"
REQUESTED_PYTHON_BIN="${HETERO_PYTHON_BIN:-}"
REQUESTED_LLVM_BIN_ROOT="${HETERO_LLVM_BIN_ROOT:-}"
REQUESTED_GLSLANG_BIN="${HETERO_GLSLANG_BIN:-}"
REQUESTED_OPENHARMONY_SDK_ROOT="${HETERO_OPENHARMONY_SDK_ROOT:-}"
REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT="${HETERO_OPENHARMONY_NATIVE_SDK_ROOT:-}"
REQUESTED_PMU_SAMPLER_BUNDLE_ROOT="${HETERO_PMU_SAMPLER_BUNDLE_ROOT:-}"
REQUESTED_RUNTIME_LIBRARY_ROOT="${HETERO_RUNTIME_LIBRARY_ROOT:-}"
REQUESTED_BUILD_RUNTIME_LIBRARY_ROOT="${HETERO_BUILD_RUNTIME_LIBRARY_ROOT:-}"
REQUESTED_HDC_BIN="${HETERO_HDC_BIN:-}"
REQUESTED_OPENCODE_BIN="${HETERO_OPENCODE_BIN:-}"
REQUESTED_AGENT_CLI_CONFIG="${HETERO_AGENT_CLI_CONFIG:-}"
REQUESTED_AGENT_CLI_ADAPTER="${HETERO_AGENT_CLI_ADAPTER:-}"
REQUESTED_DEFAULT_SOURCE_ROOT="${HETERO_DEFAULT_SOURCE_ROOT:-}"
REQUESTED_TRACE_FIXTURE_ROOT="${HETERO_TRACE_FIXTURE_ROOT:-}"
OWNED_ONLY_STOP=0
DEFAULT_WEB_PORT=4032
PYTHON_BIN=""
PYTHON_VERSION=""

usage() {
    cat <<'EOF'
Usage: deploy/linux/heteroctl <command> [options]

Commands:
  init        Create the runtime tree and platform.env without installing dependencies
  install     Install the selected runtime; worker mode installs only Python/API dependencies
  start       Start FastAPI, its managed Kimi Server, and Next.js in the background
  stop        Stop only processes started by this runtime
  restart     Stop and start the runtime
  status      Show process ownership and HTTP readiness
  doctor      Probe the browser bootstrap path and show recent service errors
  python-check Show the selected Python and managed virtualenv interpreter
  agent-check Validate the Agent Adapter manifest, default selection and executable
  preflight   Validate core resources; accepts --require-trace/--require-build/--require-device/--require-pmu
  sdk         Build assets/openharmony-sdk from an OpenHarmony source tree
  pmu         Restore the bundled PMU sampler, or rebuild it with an explicitly configured SDK
  runtime-libs Register one shared AArch64 OpenHarmony runtime-library directory (compatibility/hot update)
  logs        Show recent logs; optionally pass --service kimi|api|web
  paths       Print every mutable path used by this deployment

Options:
  --runtime-root PATH  Runtime directory (default: <repository>/heterogeneous-enable-web-runtime)
  --remote             Allow browsers on other computers to access the Web UI (default)
  --local              Restrict the Web UI to this Linux machine
  --analysis-only      Analysis deployment; skip device resource checks and disable device validation
  --worker-only        Desktop-first Linux Worker; enable build/trace and disable server device access
  --with-device-validation Enable device validation and check its resources (default for a new runtime)
  --web-port PORT      Persist the Web UI port for this runtime (default: 4032)
  --python-bin PATH    Use and persist an explicit Python 3.11+ interpreter
  --llvm-bin-root PATH Persist the Linux-host LLVM bin directory used by Build Worker
  --agent-adapter ID   Persist the default page Agent Adapter
  --skip-deps          Reuse existing Kimi Code, .venv and node_modules
  --skip-python-deps   Reuse only the existing Python .venv
  --skip-web-deps      Reuse only the existing node_modules
  --skip-kimi          Reuse an existing Kimi Code binary or run without Agent features
  --skip-build         Install dependencies without creating the production Web build
  --refresh-env        Regenerate platform.env during install
  --require-trace      Require TraceStreamer during preflight
  --require-build      Require compiler, SDK and runtime-library assets during preflight
  --require-device     Require compiler, SDK and device build assets during preflight
  --require-pmu        Require a verified PMU sampler bundle during preflight
  --service NAME       Select one service for logs
  --source-root PATH   OpenHarmony checkout used by install or sdk to build the compact SDK
  --library-root PATH  Register shared AArch64 OpenHarmony .so files during start/restart
  --owned-only         Stop only processes proven by this runtime's PID files
  -h, --help           Show this help

Preferred resource configuration:
  Export HETERO_PYTHON_BIN, HETERO_LLVM_BIN_ROOT, HETERO_GLSLANG_BIN, HETERO_TRACE_STREAMER,
  HETERO_OPENHARMONY_SDK_ROOT, HETERO_OPENHARMONY_NATIVE_SDK_ROOT,
  HETERO_PMU_SAMPLER_BUNDLE_ROOT or HETERO_RUNTIME_LIBRARY_ROOT before running
  init/install/start/restart. Non-empty overrides are validated and persisted
  in this runtime's platform.env; --refresh-env is not required.

Web dependency installation follows the registry URLs committed in package-lock.json.
Set HETERO_NPM_REGISTRY only when an explicitly managed mirror contains every
locked package version.

This controller is rootless. It never invokes sudo, systemd, an OS package manager,
or writes under protected system trees such as /var, /opt, /etc and /usr.
EOF
}

normalize_web_port_argument() {
    local value="$1"
    local port
    if [[ ! "$value" =~ ^[0-9]+$ || ${#value} -gt 5 ]]; then
        echo "--web-port must be an integer from 1 to 65535, not ${value}." >&2
        return 2
    fi
    port=$((10#$value))
    if (( port < 1 || port > 65535 )); then
        echo "--web-port must be an integer from 1 to 65535, not ${value}." >&2
        return 2
    fi
    printf '%s\n' "$port"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --runtime-root)
            [[ $# -ge 2 ]] || { echo "--runtime-root requires a path" >&2; exit 2; }
            RUNTIME_ROOT="$2"
            shift 2
            ;;
        --remote|--local)
            requested_mode="${1#--}"
            if [[ -n "$REQUESTED_ACCESS_MODE" && "$REQUESTED_ACCESS_MODE" != "$requested_mode" ]]; then
                echo "--local and --remote cannot be used together." >&2
                exit 2
            fi
            REQUESTED_ACCESS_MODE="$requested_mode"
            shift
            ;;
        --analysis-only|--worker-only|--with-device-validation)
            selected_mode="device"
            [[ "$1" != "--analysis-only" ]] || selected_mode="analysis"
            [[ "$1" != "--worker-only" ]] || selected_mode="worker"
            REQUESTED_DEPLOYMENT_MODE="$selected_mode"
            shift
            ;;
        --web-port)
            [[ $# -ge 2 ]] || { echo "--web-port requires a port" >&2; exit 2; }
            REQUESTED_WEB_PORT="$(normalize_web_port_argument "$2")" || exit 2
            shift 2
            ;;
        --web-port=*)
            REQUESTED_WEB_PORT="$(normalize_web_port_argument "${1#--web-port=}")" || exit 2
            shift
            ;;
        --python-bin)
            [[ $# -ge 2 ]] || { echo "--python-bin requires an executable path or command" >&2; exit 2; }
            REQUESTED_PYTHON_BIN="$2"
            shift 2
            ;;
        --python-bin=*)
            REQUESTED_PYTHON_BIN="${1#--python-bin=}"
            shift
            ;;
        --llvm-bin-root)
            [[ $# -ge 2 ]] || { echo "--llvm-bin-root requires a path" >&2; exit 2; }
            REQUESTED_LLVM_BIN_ROOT="$2"
            shift 2
            ;;
        --llvm-bin-root=*)
            REQUESTED_LLVM_BIN_ROOT="${1#--llvm-bin-root=}"
            shift
            ;;
        --agent-adapter)
            [[ $# -ge 2 ]] || { echo "--agent-adapter requires an adapter id" >&2; exit 2; }
            REQUESTED_AGENT_CLI_ADAPTER="$2"
            shift 2
            ;;
        --agent-adapter=*)
            REQUESTED_AGENT_CLI_ADAPTER="${1#--agent-adapter=}"
            shift
            ;;
        --skip-deps)
            SKIP_PYTHON_DEPS=1
            SKIP_WEB_DEPS=1
            SKIP_KIMI=1
            shift
            ;;
        --skip-python-deps)
            SKIP_PYTHON_DEPS=1
            shift
            ;;
        --skip-web-deps)
            SKIP_WEB_DEPS=1
            shift
            ;;
        --skip-kimi)
            SKIP_KIMI=1
            shift
            ;;
        --skip-build)
            SKIP_BUILD=1
            shift
            ;;
        --refresh-env)
            REFRESH_ENV=1
            shift
            ;;
        --require-trace|--require-build|--require-device|--require-pmu)
            PREFLIGHT_ARGS+=("$1")
            shift
            ;;
        --service)
            [[ $# -ge 2 ]] || { echo "--service requires a name" >&2; exit 2; }
            LOG_SERVICE="$2"
            shift 2
            ;;
        --source-root)
            [[ $# -ge 2 ]] || { echo "--source-root requires a path" >&2; exit 2; }
            SDK_SOURCE_ROOT="$2"
            shift 2
            ;;
        --library-root)
            [[ $# -ge 2 ]] || { echo "--library-root requires a path" >&2; exit 2; }
            RUNTIME_LIBRARY_ROOT="$2"
            shift 2
            ;;
        --owned-only)
            OWNED_ONLY_STOP=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -n "$RUNTIME_LIBRARY_ROOT" ]]; then
    REQUESTED_RUNTIME_LIBRARY_ROOT="$RUNTIME_LIBRARY_ROOT"
fi

case "$RUNTIME_ROOT" in
    *$'\n'*|*$'\r'*|*'"'*|*'`'*|*'$'*|*'\\'*)
        echo "Runtime path cannot contain a newline, double quote, backtick, dollar sign or backslash." >&2
        exit 2
        ;;
esac

resolve_python_candidate() {
    local candidate="$1"
    local resolved=""
    case "$candidate" in
        "~/"*) candidate="${HOME}/${candidate:2}" ;;
    esac
    if [[ "$candidate" == */* ]]; then
        [[ -f "$candidate" && -x "$candidate" ]] || return 1
        resolved="$candidate"
    else
        resolved="$(command -v "$candidate" 2>/dev/null || true)"
        [[ -n "$resolved" && -x "$resolved" ]] || return 1
    fi
    printf '%s\n' "$resolved"
}

python_version_string() {
    "$1" -c 'import platform; print(platform.python_version())' 2>/dev/null
}

python_version_supported() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

python_executable_identity() {
    "$1" -c 'import os,sys; print(os.path.realpath(sys.executable))' 2>/dev/null
}

python_base_executable_identity() {
    "$1" -c 'import os,sys; print(os.path.realpath(getattr(sys, "_base_executable", sys.executable)))' 2>/dev/null
}

load_persisted_python_request() {
    [[ -z "$REQUESTED_PYTHON_BIN" ]] || return 0
    local runtime_candidate="$RUNTIME_ROOT"
    local environment_candidate=""
    local persisted=""
    case "$runtime_candidate" in
        "~/"*) runtime_candidate="${HOME}/${runtime_candidate:2}" ;;
    esac
    environment_candidate="${runtime_candidate%/}/platform.env"
    [[ -f "$environment_candidate" ]] || return 0
    persisted="$(
        unset HETERO_PYTHON_BIN
        # platform.env is generated locally and contains assignment statements.
        # shellcheck disable=SC1090
        source "$environment_candidate"
        printf '%s' "${HETERO_PYTHON_BIN:-}"
    )"
    [[ -z "$persisted" ]] || REQUESTED_PYTHON_BIN="$persisted"
}

resolve_python_bin() {
    [[ -n "$PYTHON_BIN" ]] && return 0
    load_persisted_python_request
    local candidates=()
    local candidate resolved version
    local observed=()
    if [[ -n "$REQUESTED_PYTHON_BIN" ]]; then
        candidates+=("$REQUESTED_PYTHON_BIN")
    else
        candidates+=(
            "${APP_ROOT}/.venv/bin/python"
            python3.11
            python3.12
            python3.13
            python3.14
            python3
        )
    fi
    for candidate in "${candidates[@]}"; do
        resolved="$(resolve_python_candidate "$candidate" || true)"
        [[ -n "$resolved" ]] || continue
        version="$(python_version_string "$resolved" || true)"
        observed+=("${resolved}${version:+ (${version})}")
        if python_version_supported "$resolved"; then
            PYTHON_BIN="$resolved"
            PYTHON_VERSION="$version"
            return 0
        fi
    done
    if [[ -n "$REQUESTED_PYTHON_BIN" ]]; then
        echo "HETERO_PYTHON_BIN/--python-bin must identify an executable Python 3.11+ interpreter: ${REQUESTED_PYTHON_BIN}" >&2
    else
        echo "Python 3.11 or newer was not found." >&2
    fi
    if [[ ${#observed[@]} -gt 0 ]]; then
        echo "Checked: ${observed[*]}" >&2
    fi
    echo "Set HETERO_PYTHON_BIN=/absolute/path/to/python3.11 or pass --python-bin PATH." >&2
    return 1
}

canonical_path() {
    resolve_python_bin
    "$PYTHON_BIN" -c 'import os,sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))' "$1"
}

reject_system_write_path() {
    local label="$1"
    local expanded
    local resolved
    resolve_python_bin
    expanded="$("$PYTHON_BIN" -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$2")"
    resolved="$(canonical_path "$2")"
    local candidate
    for candidate in "$expanded" "$resolved"; do
        case "$candidate" in
            /|/bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|/opt|/opt/*|/proc|/proc/*|/root|/root/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|/tmp|/tmp/*|/usr|/usr/*|/var|/var/*|/private/etc|/private/etc/*|/private/tmp|/private/tmp/*|/private/var|/private/var/*)
                echo "${label} must be a user-owned path, not ${candidate}." >&2
                exit 2
                ;;
        esac
    done
    printf '%s\n' "$resolved"
}

require_runtime_child() {
    local label="$1"
    local resolved
    resolved="$(reject_system_write_path "$label" "$2")"
    case "$resolved" in
        "$RUNTIME_ROOT"|"$RUNTIME_ROOT"/*) ;;
        *)
            echo "${label} must stay below runtime root ${RUNTIME_ROOT}, not ${resolved}." >&2
            exit 2
            ;;
    esac
}

validate_planned_paths() {
    require_runtime_child "Environment file" "$ENV_FILE"
    require_runtime_child "State directory" "$STATE_DIR"
    require_runtime_child "Asset directory" "$ASSET_DIR"
    require_runtime_child "Log directory" "$LOG_DIR"
    require_runtime_child "PID directory" "$PID_DIR"
    require_runtime_child "Cache directory" "$CACHE_DIR"
    require_runtime_child "Temporary directory" "$TMP_DIR"
}

make_runtime_root() {
    if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
        echo "Do not run heteroctl as root. Use the account that will run the platform." >&2
        exit 1
    fi
    resolve_python_bin
    validate_env_scalar "Repository path" "$APP_ROOT"
    reject_system_write_path "Repository" "$APP_ROOT" >/dev/null
    RUNTIME_ROOT="$(reject_system_write_path "Runtime root" "$RUNTIME_ROOT")"
    if [[ "$RUNTIME_ROOT" == "$APP_ROOT" ]]; then
        echo "Runtime root must be a directory below or outside the repository, not the repository itself." >&2
        exit 2
    fi
    mkdir -p "$RUNTIME_ROOT"
    [[ -w "$RUNTIME_ROOT" ]] || {
        echo "Runtime root is not writable by the current user: ${RUNTIME_ROOT}" >&2
        exit 2
    }
    RUNTIME_ROOT="$(cd "$RUNTIME_ROOT" && pwd -P)"
}

set_paths() {
    ENV_FILE="${RUNTIME_ROOT}/platform.env"
    STATE_DIR="${RUNTIME_ROOT}/state"
    ASSET_DIR="${RUNTIME_ROOT}/assets"
    LOG_DIR="${RUNTIME_ROOT}/logs"
    PID_DIR="${RUNTIME_ROOT}/run"
    CACHE_DIR="${RUNTIME_ROOT}/cache"
    TMP_DIR="${RUNTIME_ROOT}/tmp"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Missing prerequisite: $1" >&2
        return 1
    }
}

check_node_version() {
    node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>20||(a===20&&b>=9)?0:1)' || {
        echo "Node.js 20.9 or newer is required; found $(node --version)." >&2
        return 1
    }
}

check_python_version() {
    resolve_python_bin
    echo "Python interpreter: ${PYTHON_BIN} (Python ${PYTHON_VERSION})"
}

validate_tcp_port() {
    local label="$1"
    local value="$2"
    if [[ ! "$value" =~ ^[0-9]+$ || ${#value} -gt 5 ]]; then
        echo "${label} must be an integer from 1 to 65535, not ${value}." >&2
        exit 2
    fi
    if (( 10#$value < 1 || 10#$value > 65535 )); then
        echo "${label} must be an integer from 1 to 65535, not ${value}." >&2
        exit 2
    fi
}

validate_env_scalar() {
    local label="$1"
    local value="$2"
    case "$value" in
        *$'\n'*|*$'\r'*|*'"'*|*'`'*|*'$'*|*'\\'*)
            echo "${label} contains characters that cannot be represented safely in platform.env." >&2
            exit 2
            ;;
    esac
}

validated_llvm_bin_root() {
    local requested="$1"
    local resolved
    [[ -n "$requested" ]] || return 1
    validate_env_scalar "LLVM bin path" "$requested"
    resolved="$(canonical_path "$requested")"
    [[ -d "$resolved" ]] || {
        echo "LLVM bin root is not a directory: ${resolved}" >&2
        return 2
    }
    local tool
    for tool in clang clang++ ld.lld; do
        [[ -x "${resolved}/${tool}" ]] || {
            echo "LLVM bin root must contain executable ${tool}: ${resolved}/${tool}" >&2
            return 2
        }
    done
    printf '%s\n' "$resolved"
}

validated_resource_path() {
    local label="$1"
    local requested="$2"
    local expected="$3"
    local resolved
    validate_env_scalar "$label" "$requested"
    resolved="$(canonical_path "$requested")"
    case "$expected" in
        executable)
            [[ -f "$resolved" && -x "$resolved" ]] || {
                echo "${label} is not an executable file: ${resolved}" >&2
                return 2
            }
            ;;
        file)
            [[ -f "$resolved" ]] || {
                echo "${label} is not a file: ${resolved}" >&2
                return 2
            }
            ;;
        directory)
            [[ -d "$resolved" ]] || {
                echo "${label} is not a directory: ${resolved}" >&2
                return 2
            }
            ;;
        *)
            echo "Unknown resource path type: ${expected}" >&2
            return 2
            ;;
    esac
    printf '%s\n' "$resolved"
}

validated_executable_or_command() {
    local label="$1"
    local requested="$2"
    local resolved
    if [[ "$requested" == */* ]]; then
        validated_resource_path "$label" "$requested" executable
        return
    fi
    resolved="$(command -v "$requested" 2>/dev/null || true)"
    [[ -n "$resolved" && -x "$resolved" ]] || {
        echo "${label} is not an executable path or command on PATH: ${requested}" >&2
        return 2
    }
    canonical_path "$resolved"
}

normalize_requested_resource_overrides() {
    resolve_deployment_mode
    if [[ -n "$REQUESTED_PYTHON_BIN" ]]; then
        validate_env_scalar "Python interpreter" "$REQUESTED_PYTHON_BIN"
        resolve_python_bin
        REQUESTED_PYTHON_BIN="$(python_base_executable_identity "$PYTHON_BIN" || python_executable_identity "$PYTHON_BIN")"
    fi
    if [[ -n "$REQUESTED_AGENT_CLI_ADAPTER" && ! "$REQUESTED_AGENT_CLI_ADAPTER" =~ ^[a-z][a-z0-9-]{1,63}$ ]]; then
        echo "HETERO_AGENT_CLI_ADAPTER must match ^[a-z][a-z0-9-]{1,63}$, not ${REQUESTED_AGENT_CLI_ADAPTER}." >&2
        exit 2
    fi
    if [[ "$DEPLOYMENT_MODE" != "analysis" ]]; then
        if [[ -n "$REQUESTED_TRACE_STREAMER" ]]; then
            REQUESTED_TRACE_STREAMER="$(validated_resource_path HETERO_TRACE_STREAMER "$REQUESTED_TRACE_STREAMER" executable)"
        fi
        if [[ -n "$REQUESTED_LLVM_BIN_ROOT" ]]; then
            REQUESTED_LLVM_BIN_ROOT="$(validated_llvm_bin_root "$REQUESTED_LLVM_BIN_ROOT")"
        fi
        if [[ -n "$REQUESTED_GLSLANG_BIN" ]]; then
            REQUESTED_GLSLANG_BIN="$(validated_resource_path HETERO_GLSLANG_BIN "$REQUESTED_GLSLANG_BIN" executable)"
        fi
        if [[ -n "$REQUESTED_OPENHARMONY_SDK_ROOT" ]]; then
            REQUESTED_OPENHARMONY_SDK_ROOT="$(validated_resource_path HETERO_OPENHARMONY_SDK_ROOT "$REQUESTED_OPENHARMONY_SDK_ROOT" directory)"
        fi
        if [[ "$DEPLOYMENT_MODE" == "device" && -n "$REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT" ]]; then
            # Ordinary deployment uses the repository bundle, even if an old SDK was removed.
            # The explicit PMU build validates compiler/sysroot when it actually uses them.
            validate_env_scalar HETERO_OPENHARMONY_NATIVE_SDK_ROOT "$REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT"
            REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT="$(canonical_path "$REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT")"
        fi
        if [[ -n "$REQUESTED_RUNTIME_LIBRARY_ROOT" ]]; then
            REQUESTED_RUNTIME_LIBRARY_ROOT="$(validated_resource_path "Runtime library root" "$REQUESTED_RUNTIME_LIBRARY_ROOT" directory)"
        fi
        if [[ -n "$REQUESTED_BUILD_RUNTIME_LIBRARY_ROOT" ]]; then
            REQUESTED_BUILD_RUNTIME_LIBRARY_ROOT="$(validated_resource_path HETERO_BUILD_RUNTIME_LIBRARY_ROOT "$REQUESTED_BUILD_RUNTIME_LIBRARY_ROOT" directory)"
        fi
        if [[ "$DEPLOYMENT_MODE" == "device" && -n "$REQUESTED_HDC_BIN" ]]; then
            REQUESTED_HDC_BIN="$(validated_resource_path HETERO_HDC_BIN "$REQUESTED_HDC_BIN" executable)"
        fi
    fi
    if [[ -n "$REQUESTED_PMU_SAMPLER_BUNDLE_ROOT" ]]; then
        validate_env_scalar HETERO_PMU_SAMPLER_BUNDLE_ROOT "$REQUESTED_PMU_SAMPLER_BUNDLE_ROOT"
        REQUESTED_PMU_SAMPLER_BUNDLE_ROOT="$(reject_system_write_path HETERO_PMU_SAMPLER_BUNDLE_ROOT "$REQUESTED_PMU_SAMPLER_BUNDLE_ROOT")"
    fi
    if [[ -n "$REQUESTED_OPENCODE_BIN" ]]; then
        REQUESTED_OPENCODE_BIN="$(validated_executable_or_command HETERO_OPENCODE_BIN "$REQUESTED_OPENCODE_BIN")"
    fi
    if [[ -n "$REQUESTED_AGENT_CLI_CONFIG" ]]; then
        REQUESTED_AGENT_CLI_CONFIG="$(validated_resource_path HETERO_AGENT_CLI_CONFIG "$REQUESTED_AGENT_CLI_CONFIG" file)"
    fi
    if [[ -n "$REQUESTED_DEFAULT_SOURCE_ROOT" ]]; then
        REQUESTED_DEFAULT_SOURCE_ROOT="$(validated_resource_path HETERO_DEFAULT_SOURCE_ROOT "$REQUESTED_DEFAULT_SOURCE_ROOT" directory)"
    fi
    if [[ -n "$REQUESTED_TRACE_FIXTURE_ROOT" ]]; then
        REQUESTED_TRACE_FIXTURE_ROOT="$(validated_resource_path HETERO_TRACE_FIXTURE_ROOT "$REQUESTED_TRACE_FIXTURE_ROOT" directory)"
    fi
}

write_environment() {
    local kimi_home="${KIMI_CODE_HOME:-${STATE_DIR}/kimi-code}"
    local kimi_install_root="${HETERO_KIMI_INSTALL_ROOT:-${ASSET_DIR}/kimi-code}"
    local kimi_bin="${HETERO_KIMI_BIN:-${kimi_install_root}/bin/kimi}"
    local kimi_token="${HETERO_KIMI_SERVER_TOKEN_FILE:-${kimi_home}/server.token}"
    local access_mode="${REQUESTED_ACCESS_MODE:-remote}"
    local web_port="${REQUESTED_WEB_PORT:-${HETERO_WEB_PORT:-${DEFAULT_WEB_PORT}}}"
    local web_host="0.0.0.0"
    local trace_streamer="${REQUESTED_TRACE_STREAMER:-${ASSET_DIR}/trace-streamer/trace_streamer_linux}"
    local llvm_bin_root="${REQUESTED_LLVM_BIN_ROOT:-${ASSET_DIR}/llvm/bin}"
    local glslang_bin="${REQUESTED_GLSLANG_BIN:-${ASSET_DIR}/glslang/bin/glslang}"
    local sdk_root="${REQUESTED_OPENHARMONY_SDK_ROOT:-${ASSET_DIR}/openharmony-sdk}"
    local native_sdk_root="${REQUESTED_OPENHARMONY_NATIVE_SDK_ROOT:-}"
