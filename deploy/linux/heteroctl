patch_kimi_installer_curl_insecure() {
    local installer_path="$1"
    "$PYTHON_BIN" - "$installer_path" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
curl_token = re.compile(
    r"(?<![A-Za-z0-9_./-])curl(?!\s+(?:--insecure\b|-\w*k\w*\b))(?=\s)"
)
patched_lines: list[str] = []
replacement_count = 0

for line in text.splitlines(keepends=True):
    if line.lstrip().startswith("#"):
        patched_lines.append(line)
        continue

    patched_line, line_replacements = curl_token.subn("curl -k", line)
    patched_lines.append(patched_line)
    replacement_count += line_replacements

path.write_text("".join(patched_lines), encoding="utf-8")
print(f"    Patched {replacement_count} curl command(s) in {path} to use -k")
PY
}

install_kimi_code() {
    local requested_version="${HETERO_KIMI_VERSION:-latest}"
    local version=""
    local target=""
    local manifest_url=""
    local install_root=""
    local expected_managed_bin=""
    local temporary_root="${TMP_DIR}/kimi-code-install.$$"
    local latest_path="${temporary_root}/latest"
    local installer_path="${temporary_root}/install.sh"
    local version_output_path="${temporary_root}/installed-version.txt"
    local manifest_path="${temporary_root}/manifest.json"
    local filename=""
    local checksum=""
    local installed_version=""
    local verify_status=0

    [[ "$requested_version" == "latest" || "$requested_version" =~ ^[A-Za-z0-9._-]+$ ]] || {
        echo "Invalid HETERO_KIMI_VERSION: ${requested_version}" >&2
        return 2
    }
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64|Linux:amd64) target="linux-x64" ;;
        Linux:aarch64|Linux:arm64) target="linux-arm64" ;;
        Darwin:x86_64|Darwin:amd64) target="darwin-x64" ;;
        Darwin:arm64|Darwin:aarch64) target="darwin-arm64" ;;
        *)
            echo "Kimi Code automatic install does not support $(uname -s) $(uname -m). Use --skip-kimi and configure HETERO_KIMI_BIN." >&2
            return 1
            ;;
    esac
    install_root="$(dirname "$(dirname "${HETERO_KIMI_BIN}")")"
    case "$(canonical_path "$install_root")" in
        "${RUNTIME_ROOT}"/*) ;;
        *)
            if [[ -x "${HETERO_KIMI_BIN}" ]]; then
                echo "    Reusing externally managed Kimi Code: ${HETERO_KIMI_BIN}"
                return 0
            fi
            echo "Automatic Kimi installation is restricted to runtime root ${RUNTIME_ROOT}; configured binary is ${HETERO_KIMI_BIN}." >&2
            echo "Use --refresh-env for the managed layout, install that external binary yourself, or pass --skip-kimi." >&2
            return 1
            ;;
    esac
    expected_managed_bin="${install_root}/bin/kimi"
    if [[ "$(canonical_path "${HETERO_KIMI_BIN}")" != "$(canonical_path "$expected_managed_bin")" ]]; then
        echo "Official Kimi installer writes ${expected_managed_bin}, but HETERO_KIMI_BIN is ${HETERO_KIMI_BIN}." >&2
        echo "Use the managed bin/kimi layout, or pass --skip-kimi for an externally managed executable." >&2
        return 1
    fi
    rm -rf "$temporary_root"
    mkdir -p "$temporary_root"
    trap 'rm -rf "${temporary_root}"' RETURN
    if [[ "$requested_version" == "latest" ]]; then
        run_install_operation "查询 Kimi Code 官方最新版本" \
            curl -k --proto '=https' --tlsv1.2 --fail --location --retry 2 \
                --connect-timeout 20 --max-time 120 --silent --show-error \
                --output "$latest_path" "https://code.kimi.com/kimi-code/latest"
        version="$(tr -d '[:space:]' <"$latest_path")"
        [[ "$version" =~ ^[A-Za-z0-9._-]+$ ]] || {
            echo "Kimi Code latest endpoint returned an invalid version: ${version:-<empty>}" >&2
            return 1
        }
        echo "    Kimi Code official latest version: ${version}"
    else
        version="$requested_version"
        echo "    Using explicitly pinned Kimi Code version: ${version}"
    fi
    if [[ -x "${HETERO_KIMI_BIN}" ]]; then
        if [[ -f "${install_root}/VERSION" ]]; then
            installed_version="$(tr -d '[:space:]' <"${install_root}/VERSION")"
        else
            run_install_operation_capture \
                "检查现有 Kimi Code 版本" "$version_output_path" \
                "${HETERO_KIMI_BIN}" --version || true
            installed_version="$(head -n 1 "$version_output_path" 2>/dev/null | tr -d '[:space:]' || true)"
        fi
        if [[ "$installed_version" == *"${version}"* ]]; then
            echo "    Kimi Code ${version} is already installed at ${HETERO_KIMI_BIN}"
            return 0
        fi
        echo "    Updating Kimi Code from ${installed_version:-unknown} to ${version}"
    fi

    run_install_operation "下载 Kimi Code 官方安装器" \
        curl -k -fsSL --proto '=https' --tlsv1.2 --retry 2 \
            --connect-timeout 20 --max-time 120 \
            --output "$installer_path" "https://code.kimi.com/kimi-code/install.sh"
    run_install_operation "为 Kimi Code 官方安装器启用 curl -k" \
        patch_kimi_installer_curl_insecure "$installer_path"
    if [[ "$requested_version" == "latest" ]]; then
        run_install_operation "执行 Kimi Code 官方最新版安装器" \
            env KIMI_INSTALL_DIR="$install_root" KIMI_NO_MODIFY_PATH=1 \
                bash "$installer_path"
    else
        run_install_operation "执行 Kimi Code 官方指定版本安装器" \
            env KIMI_INSTALL_DIR="$install_root" KIMI_NO_MODIFY_PATH=1 KIMI_VERSION="$version" \
                bash "$installer_path"
    fi
    [[ -x "${HETERO_KIMI_BIN}" ]] || {
        echo "Official Kimi installer completed without creating ${HETERO_KIMI_BIN}." >&2
        return 1
    }
    run_install_operation_capture \
        "读取新安装的 Kimi Code 版本" "$version_output_path" \
        "${HETERO_KIMI_BIN}" --version
    installed_version="$(head -n 1 "$version_output_path" | tr -d '[:space:]')"
    [[ "$installed_version" =~ ^[A-Za-z0-9._-]+$ ]] || {
        echo "Installed Kimi Code returned an invalid version: ${installed_version:-<empty>}" >&2
        return 1
    }
    if [[ "$requested_version" != "latest" && "$installed_version" != *"${version}"* ]]; then
        echo "Official Kimi installer returned ${installed_version}, expected ${version}." >&2
        return 1
    fi
    version="$installed_version"

    manifest_url="https://code.kimi.com/kimi-code/binaries/${version}/manifest.json"
    run_install_operation "下载 Kimi Code ${version} 校验清单" \
        curl -k -fsSL --proto '=https' --tlsv1.2 --retry 2 \
            --connect-timeout 20 --max-time 120 \
            --output "$manifest_path" "$manifest_url"
    read -r filename checksum < <("$PYTHON_BIN" - "$manifest_path" "$target" <<'PY'
import json
import re
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
entry = manifest.get("platforms", {}).get(sys.argv[2], {})
filename = entry.get("filename", "")
checksum = entry.get("checksum", "")
if not isinstance(filename, str) or not re.fullmatch(r"[A-Za-z0-9._-]+", filename):
    raise SystemExit("manifest contains an unsafe Kimi binary filename")
if not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum):
    raise SystemExit("manifest contains an invalid Kimi binary checksum")
print(filename, checksum)
PY
    )
    begin_install_operation \
        "独立校验已安装 Kimi Code 的 SHA-256" \
        "$PYTHON_BIN" - "${HETERO_KIMI_BIN}" "$checksum"
    if "$PYTHON_BIN" - "${HETERO_KIMI_BIN}" "$checksum" <<'PY'
import hashlib
import sys
from pathlib import Path

path = Path(sys.argv[1])
expected = sys.argv[2]
actual = hashlib.sha256(path.read_bytes()).hexdigest()
if actual != expected:
    raise SystemExit(f"Kimi binary checksum mismatch: expected {expected}, got {actual}")
PY
    then
        verify_status=0
    else
        verify_status="$?"
    fi
    finish_install_operation
    [[ "$verify_status" -eq 0 ]] || return "$verify_status"
    mkdir -p "${KIMI_CODE_HOME}"
    printf '%s\n' "$version" >"${install_root}/VERSION"
    echo "    Installed and independently verified Kimi Code ${version}: ${HETERO_KIMI_BIN}"
    rm -rf "$temporary_root"
    trap - RETURN
}

install_web_dependencies() {
    local npm_status=0
    local latest_log=""
    local configured_npm_registry=""
    local install_npm_registry="${HETERO_NPM_REGISTRY:-https://registry.npmjs.org/}"
    local replace_registry_host="never"
    if [[ -n "${HETERO_NPM_REGISTRY:-}" ]]; then
        replace_registry_host="always"
    fi
    (
        cd "$APP_ROOT"
        [[ -f package.json ]] || { echo "Web dependency manifest is missing: ${APP_ROOT}/package.json" >&2; exit 1; }
        [[ -f package-lock.json ]] || { echo "npm ci lockfile is missing: ${APP_ROOT}/package-lock.json" >&2; exit 1; }
        run_install_operation "安装 Web 前端依赖（npm ci）" \
            env npm_config_cache="$CACHE_DIR/npm" \
            npm_config_fetch_retries=2 \
            npm_config_fetch_retry_mintimeout=10000 \
            npm_config_fetch_retry_maxtimeout=60000 \
            npm_config_fetch_timeout=120000 \
                npm ci --no-audit --no-fund --foreground-scripts --loglevel=http --timing \
                    --registry="$install_npm_registry" \
                    --replace-registry-host="$replace_registry_host"
    ) || npm_status="$?"
    if [[ "$npm_status" -ne 0 ]]; then
        configured_npm_registry="$(npm config get registry 2>/dev/null || true)"
        echo "    Web 前端依赖安装诊断：" >&2
        echo "      repository=${APP_ROOT}" >&2
        echo "      node=$(command -v node 2>/dev/null || echo unavailable) $({ node --version 2>/dev/null || true; } | head -n 1)" >&2
        echo "      npm=$(command -v npm 2>/dev/null || echo unavailable) $({ npm --version 2>/dev/null || true; } | head -n 1)" >&2
        echo "      cache=${CACHE_DIR}/npm" >&2
        echo "      install_registry=${install_npm_registry}" >&2
        echo "      replace_registry_host=${replace_registry_host}" >&2
        [[ -n "$configured_npm_registry" ]] && echo "      user_configured_registry=${configured_npm_registry}" >&2
        latest_log="$(find "$CACHE_DIR/npm/_logs" -type f -name '*debug-0.log' -print 2>/dev/null | sort | tail -n 1 || true)"
        if [[ -n "$latest_log" ]]; then
            echo "    npm 调试日志：${latest_log}" >&2
            tail -n 120 "$latest_log" >&2 || true
            if grep -Eiq '(^|[^0-9])(E404|404)([^0-9]|$)' "$latest_log"; then
                echo "    检测到 registry 404：请核对日志中的实际下载主机；默认安装应为 registry.npmjs.org。" >&2
            fi
        else
            echo "    npm 未生成 debug log；失败发生在 npm 初始化、工作目录或清单检查阶段。" >&2
        fi
        return "$npm_status"
    fi
}

build_production_web() {
    local build_root="${APP_ROOT}/.next"
    local backup_root="${APP_ROOT}/.next-production-backup.$$"
    local build_status=0
    local validator_args=(
        -m backend.tools.validate_next_build
        --build-dir "$build_root"
        --write-asset-index
    )
    [[ ! -e "$backup_root" ]] || {
        echo "Temporary production build backup already exists: ${backup_root}" >&2
        return 1
    }
    if [[ -e "$build_root" ]]; then
        mv "$build_root" "$backup_root"
    fi

    if (
        cd "$APP_ROOT"
        run_install_operation "执行 Next.js 生产构建（npm run build）" \
            env npm_config_cache="$CACHE_DIR/npm" npm run build
    ); then
        build_status=0
    else
        build_status=$?
    fi
    if [[ "$build_status" -eq 0 ]]; then
        [[ -e "$backup_root" ]] && validator_args+=(--retain-from "$backup_root")
        if run_install_operation "校验 Next.js manifest 与静态资源完整性" \
            "${APP_ROOT}/.venv/bin/python" "${validator_args[@]}"; then
            build_status=0
        else
            build_status=$?
        fi
    fi

    if [[ "$build_status" -ne 0 ]]; then
        echo "Production Web build failed validation; restoring the previous complete build." >&2
        rm -rf "$build_root"
        if [[ -e "$backup_root" ]]; then
            mv "$backup_root" "$build_root"
        fi
        return "$build_status"
    fi
    rm -rf "$backup_root"
}

verify_agent_tool_policy() {
    local output_file="${TMP_DIR}/agent-tool-policy.$$.json"
    local api="http://127.0.0.1:${HETERO_API_PORT:-8006}"
    local status="000"
    local summary=""
    status="$(curl --noproxy '*' --max-time 15 -sS -o "$output_file" -w '%{http_code}' \
        "${api}/v1/agent-engine/health" 2>/dev/null || true)"
    if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then
        echo "Kimi tool-policy check failed: HTTP ${status}." >&2
        [[ -s "$output_file" ]] && { head -c 1200 "$output_file" >&2; echo >&2; }
        rm -f "$output_file"
        return 1
    fi
    if ! summary="$("${APP_ROOT}/.venv/bin/python" - "$output_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    root = json.load(stream)
engine = root.get("engine") if isinstance(root, dict) else {}
engine = engine if isinstance(engine, dict) else {}
policy = engine.get("tool_policy") if isinstance(engine.get("tool_policy"), dict) else {}
disabled = set(policy.get("disabled_tools") or [])
native = set(policy.get("native_backend_tools") or [])
required_native = {"Bash", "Read", "Edit", "Glob", "Grep"}
valid = (
    policy.get("backend_control") == "kimi_native_tools"
    and policy.get("native_tool_mode") == "all_available_except_disabled"
    and disabled == {"FetchURL", "WebSearch"}
    and required_native.issubset(native)
    and not disabled.intersection(required_native)
    and policy.get("web_search_enabled") is False
    and policy.get("web_fetch_enabled") is False
)
print(
    "backend=all-native-tools-except-disabled; "
    f"enabled={','.join(sorted(required_native))}; "
    f"disabled={','.join(sorted(disabled))}"
)
raise SystemExit(0 if valid else 1)
PY
)"; then
        echo "Kimi tool-policy check failed: ${summary}" >&2
        rm -f "$output_file"
        return 1
    fi
    rm -f "$output_file"
    echo "kimi-tool-policy: ready (${summary})"
}

