listener_scope_for_port() {
    local port="$1"
    local port_hex
    local proc_net_root="${HETERO_PROC_NET_ROOT:-/proc/net}"
    local proc_files=()
    [[ "$port" =~ ^[0-9]+$ ]] || { printf '%s\n' unknown; return; }
    printf -v port_hex '%04X' "$port"
    [[ -r "${proc_net_root}/tcp" ]] && proc_files+=("${proc_net_root}/tcp")
    [[ -r "${proc_net_root}/tcp6" ]] && proc_files+=("${proc_net_root}/tcp6")
    if [[ ${#proc_files[@]} -eq 0 ]]; then
        printf '%s\n' unknown
        return
    fi
    awk -v expected_port="$port_hex" '
        FNR > 1 && $4 == "0A" {
            split($2, endpoint, ":")
            if (endpoint[2] != expected_port) {
                next
            }
            address = endpoint[1]
            if (address == "0100007F" || address == "00000000000000000000000001000000") {
                local_listener = 1
            } else {
                remote_listener = 1
            }
        }
        END {
            if (remote_listener) {
                print "remote"
            } else if (local_listener) {
                print "local"
            } else {
                print "none"
            }
        }
    ' "${proc_files[@]}"
}

